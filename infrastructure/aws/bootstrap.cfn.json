{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Manual administrator setup only. Never deployed by the application workflow. Requires an existing GitHub OIDC provider.",
  "Parameters": {
    "DeployRegion": {
      "Type": "String",
      "Default": "eu-central-1"
    },
    "DistributionId": {
      "Type": "String",
      "Default": "NOT_CONFIGURED"
    },
    "CredentialsSecretName": {
      "Type": "String",
      "Default": "movie-explorer/provider-credentials"
    }
  },
  "Resources": {
    "RuntimeBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "movie-explorer-runtime-boundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "logs:DescribeLogStreams"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:logs:${DeployRegion}:${AWS::AccountId}:log-group:/aws/lambda/movie-explorer-api:*"
              }
            }
          ]
        }
      }
    },
    "ExecutionPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "movie-explorer-cfn-execution",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:CreateBucket",
                "s3:DeleteBucket",
                "s3:GetBucket*",
                "s3:PutBucket*",
                "s3:DeleteBucketPolicy",
                "s3:GetEncryptionConfiguration",
                "s3:PutEncryptionConfiguration",
                "s3:GetLifecycleConfiguration",
                "s3:PutLifecycleConfiguration",
                "s3:ListBucket"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::movie-explorer-frontend-${AWS::AccountId}-${DeployRegion}"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "lambda:CreateFunction",
                "lambda:GetFunction",
                "lambda:GetFunctionConfiguration",
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:DeleteFunction",
                "lambda:TagResource",
                "lambda:UntagResource",
                "lambda:ListTags",
                "lambda:AddPermission",
                "lambda:RemovePermission",
                "lambda:GetPolicy",
                "lambda:PutFunctionConcurrency",
                "lambda:DeleteFunctionConcurrency",
                "lambda:GetFunctionConcurrency"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:lambda:${DeployRegion}:${AWS::AccountId}:function:movie-explorer-api"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "lambda:GetLayerVersion"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:lambda:${DeployRegion}:753240598075:layer:LambdaAdapterLayerArm64:30"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:DeleteLogGroup",
                "logs:PutRetentionPolicy",
                "logs:DeleteRetentionPolicy",
                "logs:TagResource",
                "logs:UntagResource",
                "logs:ListTagsForResource"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${DeployRegion}:${AWS::AccountId}:log-group:/movie-explorer/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${DeployRegion}:${AWS::AccountId}:log-group:/aws/lambda/movie-explorer-api:*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "apigateway:GET",
                "apigateway:POST",
                "apigateway:PUT",
                "apigateway:PATCH",
                "apigateway:DELETE"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:apigateway:${DeployRegion}::/apis*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "cloudfront:UpdateDistribution",
                "cloudfront:GetDistribution",
                "cloudfront:GetDistributionConfig",
                "cloudfront:DeleteDistribution",
                "cloudfront:TagResource",
                "cloudfront:UntagResource",
                "cloudfront:ListTagsForResource",
                "cloudfront:GetOriginAccessControl",
                "cloudfront:UpdateOriginAccessControl",
                "cloudfront:DeleteOriginAccessControl",
                "cloudfront:GetResponseHeadersPolicy",
                "cloudfront:UpdateResponseHeadersPolicy",
                "cloudfront:DeleteResponseHeadersPolicy",
                "cloudfront:DescribeFunction",
                "cloudfront:GetFunction",
                "cloudfront:UpdateFunction",
                "cloudfront:PublishFunction",
                "cloudfront:DeleteFunction",
                "cloudfront:GetOriginAccessControlConfig",
                "cloudfront:GetResponseHeadersPolicyConfig"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:origin-access-control/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:response-headers-policy/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:function/MovieExplorer*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:CreateRole",
                "iam:PutRolePermissionsBoundary"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/movie-explorer-api-runtime"
              },
              "Condition": {
                "StringEquals": {
                  "iam:PermissionsBoundary": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/movie-explorer-runtime-boundary"
                  }
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:GetRole",
                "iam:DeleteRole",
                "iam:GetRolePolicy",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:TagRole",
                "iam:UntagRole"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/movie-explorer-api-runtime"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:PassRole"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/movie-explorer-api-runtime"
              },
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "lambda.amazonaws.com"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:DescribeSecret"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:${DeployRegion}:${AWS::AccountId}:secret:${CredentialsSecretName}-??????"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "cloudwatch:PutMetricAlarm",
                "cloudwatch:DeleteAlarms",
                "cloudwatch:DescribeAlarms",
                "cloudwatch:TagResource",
                "cloudwatch:UntagResource",
                "cloudwatch:ListTagsForResource"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${DeployRegion}:${AWS::AccountId}:alarm:MovieExplorer-*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "sns:CreateTopic",
                "sns:DeleteTopic",
                "sns:GetTopicAttributes",
                "sns:SetTopicAttributes",
                "sns:TagResource",
                "sns:UntagResource",
                "sns:ListTagsForResource",
                "sns:Subscribe",
                "sns:Unsubscribe",
                "sns:GetSubscriptionAttributes",
                "sns:SetSubscriptionAttributes"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:sns:${DeployRegion}:${AWS::AccountId}:MovieExplorer-*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "acm:DescribeCertificate"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:acm:us-east-1:${AWS::AccountId}:certificate/*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogDelivery",
                "logs:DescribeLogGroups",
                "logs:PutResourcePolicy",
                "logs:UpdateLogDelivery",
                "logs:DeleteLogDelivery",
                "logs:DescribeResourcePolicies",
                "logs:GetLogDelivery",
                "logs:ListLogDeliveries"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeployRegion"
                  }
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "cloudfront:CreateDistribution",
                "cloudfront:CreateOriginAccessControl",
                "cloudfront:CreateResponseHeadersPolicy",
                "cloudfront:CreateFunction"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    },
    "GithubRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "movie-explorer-github-deploy",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:gaborcserto/movie-explorer:environment:aws-production"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "RoutineApplicationDeployment",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sts:AssumeRole"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdk-hnb659fds-deploy-role-${AWS::AccountId}-${DeployRegion}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdk-hnb659fds-file-publishing-role-${AWS::AccountId}-${DeployRegion}"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeployRegion}:${AWS::AccountId}:stack/MovieExplorer/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${DeployRegion}:${AWS::AccountId}:parameter/cdk-bootstrap/hnb659fds/version"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::movie-explorer-frontend-${AWS::AccountId}-${DeployRegion}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::movie-explorer-frontend-${AWS::AccountId}-${DeployRegion}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${DistributionId}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "GithubRole",
          "Arn"
        ]
      }
    },
    "ExecutionPolicyArn": {
      "Value": {
        "Ref": "ExecutionPolicy"
      }
    },
    "RuntimeBoundaryArn": {
      "Value": {
        "Ref": "RuntimeBoundary"
      }
    }
  }
}
