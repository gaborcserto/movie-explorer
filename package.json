{
  "name": "movie-explorer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infrastructure/aws"
  ],
  "scripts": {
    "dev": "vp run -r --parallel --log labeled task:dev",
    "build": "vp run -r task:build",
    "test": "vp run -r task:test",
    "coverage": "vp run -r task:coverage",
    "lint": "vp run -r task:lint",
    "typecheck": "vp run -r task:typecheck",
    "test:e2e": "vp run @movie-explorer/api#task:e2e",
    "prepare": "husky",
    "aws:package": "vp run @movie-explorer/aws#task:package",
    "aws:synth": "vp run @movie-explorer/aws#task:synth",
    "aws:test": "vp run @movie-explorer/aws#task:package-test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint-plugin-oxlint": "1.90.0",
    "typescript": "6.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "vite-plus": "1.4.0",
    "yaml": "^2.9.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5",
    "@types/node": "^24.19.2"
  },
  "overrides": {
    "vitest": "$vitest",
    "vite": "$vite",
    "multer": "2.5.0",
    "js-yaml@>=5.0.0 <5.5.0": "5.5.0"
  }
}
