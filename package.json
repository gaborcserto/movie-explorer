{
  "name": "movie-explorer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infrastructure/aws"
  ],
  "scripts": {
    "dev": "vp run -r --parallel --log labeled task:dev",
    "build": "vp run -r task:build",
    "test": "vp run -r task:test",
    "coverage": "vp run -r task:coverage",
    "lint": "vp run -r task:lint",
    "typecheck": "vp run -r task:typecheck",
    "test:e2e": "vp run @movie-explorer/api#task:e2e",
    "prepare": "husky",
    "aws:package": "npm run build --workspace @movie-explorer/contracts && npm run build --workspace @movie-explorer/api && npm run package:lambda --workspace @movie-explorer/aws",
    "aws:synth": "npm run synth --workspace @movie-explorer/aws",
    "aws:test": "npm test --workspace @movie-explorer/aws && npm run test:package --workspace @movie-explorer/aws"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint-plugin-oxlint": "1.88.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "vite-plus": "1.3.0",
    "yaml": "^2.9.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5",
    "@types/node": "^24.19.2"
  },
  "overrides": {
    "vitest": "$vitest",
    "vite": "$vite",
    "multer": "2.5.0",
    "js-yaml@>=5.0.0 <5.5.0": "5.5.0"
  }
}
