{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "arrowParens": "always",
  "proseWrap": "never",
  "htmlWhitespaceSensitivity": "strict",
  "sortPackageJson": false,
  "sortImports": false,
  "ignorePatterns": [
    "node_modules",
    "package.json",
    "package-lock.json",
    "dist",
    ".idea",
    ".vscode",
    ".DS_Store"
  ]
}
