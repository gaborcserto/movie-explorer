# Required: TMDB API read access token.
NODE_ENV=development
PORT=4000
# Optional listener address, e.g. 0.0.0.0 for a container.
HOST=
# Optional comma-separated exact frontend origins (no trailing slash).
# Defaults to local origins in development, no cross-origin access in production.
# Empty is suitable for a same-origin reverse proxy.
# CORS_ORIGINS=https://movies.example.com
# Swagger defaults to enabled in development, disabled in production.
# SWAGGER_ENABLED=false
TMDB_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_LANGUAGE=en-US
TMDB_REGION=
TMDB_REQUEST_TIMEOUT_MS=8000
# Optional IMDb ratings via OMDb.
OMDB_API_URL=https://www.omdbapi.com/
OMDB_API_KEY=
