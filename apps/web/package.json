{
  "name": "@movie-explorer/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "npm run typecheck && vp build",
    "lint": "npm run lint:oxlint && npm run lint:eslint && npm run lint:typescript && npm run format:check && npm run lint:styles",
    "lint:eslint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:styles": "stylelint ./src/**/*.{css,scss}",
    "lint:typescript": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint:fix": "npm run lint:oxlint -- --fix && npm run lint:eslint -- --fix && npm run format && npm run lint:styles -- --fix",
    "format:check": "vp fmt -c .oxfmtrc.json --check \"src/**/*.{ts,tsx,js,jsx,css,scss}\" \"*.{js,ts}\"",
    "format": "vp fmt -c .oxfmtrc.json --write \"src/**/*.{ts,tsx,js,jsx,css,scss}\" \"*.{js,ts}\"",
    "preview": "vp preview",
    "typecheck": "npm run lint:typescript",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "lint:oxlint": "vp lint -c .oxlintrc.json src --max-warnings=0"
  },
  "dependencies": {
    "@movie-explorer/contracts": "0.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.1",
    "scss-reset": "^1.4.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
